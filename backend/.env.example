# Server Port configuration (optional, defaults to 5000 or Render's PORT)
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Configuration Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Node Environment (development or production)
NODE_ENV=production

# Permitted Frontend Domains (comma-separated list for CORS validation)
FRONTEND_URL=https://startup-crm-beta.vercel.app,https://startup-crm-lite.vercel.app
